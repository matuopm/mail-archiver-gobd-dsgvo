# Nach .env kopieren und alle Werte setzen. Die Datei .env nicht weitergeben.
DB_NAME=MailArchiver
# Datenbank-Verwalter (Superuser): nur fuer Wartung, nicht fuer die Anwendung
DB_ADMIN_USER=dbverwalter
DB_ADMIN_PASSWORD=HIER-EIN-LANGES-PASSWORT
# Passwort der Anwendungsrolle mailarchiver_app (anderes als oben)
APP_DB_PASSWORD=HIER-EIN-ZWEITES-LANGES-PASSWORT
# Erster Administrator der Weboberflaeche
ADMIN_USER=admin
ADMIN_PASSWORD=HIER-EIN-DRITTES-PASSWORT
# Port der Weboberflaeche auf dem Server
WEB_PORT=5010
