@model List<MailArchiver.Models.RetentionHold>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Retention"];
    var activeHold = Model.FirstOrDefault(h => h.EndedAt == null);
    int originalCount = ViewBag.OriginalCount;
    int expiredCount = ViewBag.ExpiredCount;
    int withoutOriginalCount = ViewBag.WithoutOriginalCount;
    DateTime? nextExpiry = ViewBag.NextExpiry;
}

<div class="container">
    <h1 class="h3 mb-1"><i class="bi bi-hourglass-split me-2"></i>@Localizer["Retention"]</h1>
    <p class="text-muted">@Localizer["RetentionDescription"]</p>

    <div class="card mb-4">
        <div class="card-header bg-light"><h5 class="mb-0">@Localizer["RetentionOverview"]</h5></div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-5">@Localizer["RetentionStoredOriginals"]</dt>
                <dd class="col-sm-7">@originalCount.ToString("N0")</dd>
                <dt class="col-sm-5">@Localizer["RetentionNextExpiry"]</dt>
                <dd class="col-sm-7">@(nextExpiry?.ToLocalTime().ToString("d") ?? "–")</dd>
                <dt class="col-sm-5">@Localizer["RetentionExpiredWaiting"]</dt>
                <dd class="col-sm-7">@expiredCount.ToString("N0")</dd>
                <dt class="col-sm-5">@Localizer["RetentionWithoutOriginal"]</dt>
                <dd class="col-sm-7">@withoutOriginalCount.ToString("N0")</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4 @(activeHold != null ? "border-warning" : "")">
        <div class="card-header @(activeHold != null ? "bg-warning" : "bg-light")">
            <h5 class="mb-0">@(activeHold != null ? Localizer["RetentionPausedTitle"] : Localizer["RetentionPauseTitle"])</h5>
        </div>
        <div class="card-body">
            @if (activeHold != null)
            {
                <dl class="row">
                    <dt class="col-sm-3">@Localizer["RetentionPausedSince"]</dt>
                    <dd class="col-sm-9"><span class="utc-timestamp" data-utc-time="@activeHold.StartedAt.ToString("yyyy-MM-ddTHH:mm:ss")">@activeHold.StartedAt.ToString("g")</span></dd>
                    <dt class="col-sm-3">@Localizer["RetentionPausedBy"]</dt>
                    <dd class="col-sm-9">@activeHold.StartedBy</dd>
                    <dt class="col-sm-3">@Localizer["RetentionPauseReason"]</dt>
                    <dd class="col-sm-9">@activeHold.Reason</dd>
                </dl>
                <form asp-action="Resume" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success"><i class="bi bi-play-fill"></i> @Localizer["RetentionResume"]</button>
                </form>
            }
            else
            {
                <p>@Localizer["RetentionPauseInfo"]</p>
                <form asp-action="Pause" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <div class="col-md-9">
                        <input type="text" name="reason" class="form-control" required maxlength="500"
                               placeholder="@Localizer["RetentionPauseReasonPlaceholder"]" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-warning w-100"><i class="bi bi-pause-fill"></i> @Localizer["RetentionPause"]</button>
                    </div>
                </form>
            }
        </div>
    </div>

    @if (Model.Count > 0)
    {
        <div class="card">
            <div class="card-header bg-light"><h5 class="mb-0">@Localizer["RetentionPauseHistory"]</h5></div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>@Localizer["RetentionPauseFrom"]</th>
                            <th>@Localizer["RetentionPauseTo"]</th>
                            <th>@Localizer["RetentionPauseReason"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hold in Model)
                        {
                            <tr>
                                <td><span class="utc-timestamp" data-utc-time="@hold.StartedAt.ToString("yyyy-MM-ddTHH:mm:ss")">@hold.StartedAt.ToString("g")</span> (@hold.StartedBy)</td>
                                <td>
                                    @if (hold.EndedAt.HasValue)
                                    {
                                        <span class="utc-timestamp" data-utc-time="@hold.EndedAt.Value.ToString("yyyy-MM-ddTHH:mm:ss")">@hold.EndedAt.Value.ToString("g")</span> <text>(@hold.EndedBy)</text>
                                    }
                                    else
                                    {
                                        <text>–</text>
                                    }
                                </td>
                                <td>@hold.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
